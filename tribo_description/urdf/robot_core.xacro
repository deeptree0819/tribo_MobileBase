<?xml version="1.0"?>
<robot name="tribo" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="inertial_macros.xacro"/>

    <!-- ============================================================= -->
    <!--  치수 파라미터 (단위 m)                                        -->
    <!--  주의 - 모두 사진 비율로 추정한 값. 실측 확보 시 여기만 교체.  -->
    <!--  좌표계 - X 전방, Y 좌측, Z 상방                               -->
    <!--  base_link = 바퀴 축 평면(휠 중심 z=0)                         -->
    <!-- ============================================================= -->

    <!-- 바퀴 -->
    <!-- 100mm 메카넘 공칭 반경. 운동학용 보정 반경(robot_geom.yaml 의 wheel_radius)과 -->
    <!-- 는 성격이 다르다. 여기는 물리 형상이므로 공칭값을 쓴다. -->
    <xacro:property name="wheel_radius" value="0.05"/>
    <xacro:property name="wheel_width"  value="0.04"/>
    <!-- 2026-08-19 실측으로 교체. 기존 0.14/0.25 는 위 주석대로 사진 비율 추정치였고 -->
    <!-- 실측(휠베이스 0.40, 트랙 0.74)과 크게 어긋나 있었다. -->
    <xacro:property name="wheel_x"      value="0.20"/>   <!-- 전후 휠 중심 (휠베이스 0.40 의 절반) -->
    <xacro:property name="wheel_y"      value="0.37"/>   <!-- 좌우 휠 중심 (트랙 0.74 의 절반). 차체 반폭(0.21)보다 16cm 바깥 → 좌우 크게 돌출 -->

    <!-- 하단 베이스(구동부 박스). 좌우(Y)가 더 긴 직사각형 -->
    <xacro:property name="base_x"       value="0.36"/>   <!-- 전후 길이 -->
    <xacro:property name="base_y"       value="0.42"/>   <!-- 좌우 폭. ⚠️ 미실측 추정치 — 구조 변경분 반영 안 됨 -->
    <xacro:property name="base_h"       value="0.12"/>   <!-- 높이 -->
    <xacro:property name="base_bottom"  value="0.0"/>    <!-- 베이스 박스 바닥 z = 휠 축 높이. 모터/바퀴가 하단에 위치 -->
    <xacro:property name="base_cz"      value="${base_bottom + base_h/2}"/>
    <xacro:property name="deck_z"       value="${base_bottom + base_h}"/>  <!-- 베이스 상판 = 상단 프레임/라이다 기준면 -->

    <!-- 상단 프레임(알루미늄 프로파일 케이지) -->
    <xacro:property name="frame_h"      value="0.42"/>   <!-- 기둥 높이 -->
    <xacro:property name="post_t"       value="0.02"/>   <!-- 프로파일 단면 -->
    <xacro:property name="post_x"       value="0.15"/>   <!-- 기둥 X 위치 -->
    <xacro:property name="post_y"       value="0.18"/>   <!-- 기둥 Y 위치 (차체 안쪽) -->
    <xacro:property name="top_z"        value="${deck_z + frame_h}"/>  <!-- 상단 프레임 z -->

    <!-- 라이다(하단 상판 전방 중앙) -->
    <xacro:property name="lidar_x"      value="0.16"/>

    <!-- Materials -->
    <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
    <material name="orange"><color rgba="1 0.3 0.1 1"/></material>
    <material name="blue"><color rgba="0.2 0.2 1 1"/></material>
    <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
    <material name="red"><color rgba="0.9 0.3 0.25 1"/></material>
    <material name="silver"><color rgba="0.75 0.75 0.78 1"/></material>
    <material name="cyan"><color rgba="0.2 0.6 0.7 1"/></material>
    <material name="green"><color rgba="0.1 0.8 0.2 1"/></material>

    <!-- ============================================================= -->
    <!--  BASE LINK                                                     -->
    <!-- ============================================================= -->
    <link name="base_link"/>

    <!-- ============================================================= -->
    <!--  CHASSIS = 하단 구동 베이스 (박스 + 모터 하우징 비주얼)        -->
    <!-- ============================================================= -->
    <link name="chassis">
        <!-- 베이스 박스 -->
        <visual>
            <origin xyz="0 0 ${base_cz}"/>
            <geometry><box size="${base_x} ${base_y} ${base_h}"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_cz}"/>
            <geometry><box size="${base_x} ${base_y} ${base_h}"/></geometry>
        </collision>

        <!-- 모터 하우징 4개 (빨간 원통). 베이스 하단(z=0)에 부착, 바퀴 안쪽 -->
        <!-- 모터(y≈±0.19)보다 바퀴(y=±0.25)가 바깥 → 좌우로 돌출 -->
        <visual>
            <origin xyz="${wheel_x} ${wheel_y - 0.06} 0" rpy="${pi/2} 0 0"/>
            <geometry><cylinder radius="0.04" length="0.08"/></geometry>
            <material name="red"/>
        </visual>
        <visual>
            <origin xyz="${wheel_x} ${-(wheel_y - 0.06)} 0" rpy="${pi/2} 0 0"/>
            <geometry><cylinder radius="0.04" length="0.08"/></geometry>
            <material name="red"/>
        </visual>
        <visual>
            <origin xyz="${-wheel_x} ${wheel_y - 0.06} 0" rpy="${pi/2} 0 0"/>
            <geometry><cylinder radius="0.04" length="0.08"/></geometry>
            <material name="red"/>
        </visual>
        <visual>
            <origin xyz="${-wheel_x} ${-(wheel_y - 0.06)} 0" rpy="${pi/2} 0 0"/>
            <geometry><cylinder radius="0.04" length="0.08"/></geometry>
            <material name="red"/>
        </visual>

        <!-- 무게 중심을 낮게 두기 위해 베이스에 질량 집중 -->
        <xacro:inertial_box mass="3.0" x="${base_x}" y="${base_y}" z="${base_h}">
            <origin xyz="0 0 ${base_cz}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0"/>
    </joint>

    <!-- ============================================================= -->
    <!--  바퀴 4개 (좌측 axis +Z, 우측 axis -Z) — 기존 구조 유지        -->
    <!-- ============================================================= -->
    <!-- FRONT LEFT -->
    <link name="front_left_wheel">
        <visual>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <joint name="front_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="front_left_wheel"/>
        <origin xyz="${wheel_x} ${wheel_y} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- FRONT RIGHT -->
    <link name="front_right_wheel">
        <visual>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="front_right_wheel"/>
        <origin xyz="${wheel_x} ${-wheel_y} 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <!-- REAR LEFT -->
    <link name="rear_left_wheel">
        <visual>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <joint name="rear_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="rear_left_wheel"/>
        <origin xyz="${-wheel_x} ${wheel_y} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <!-- REAR RIGHT -->
    <link name="rear_right_wheel">
        <visual>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="${wheel_width}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child  link="rear_right_wheel"/>
        <origin xyz="${-wheel_x} ${-wheel_y} 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <!-- ============================================================= -->
    <!--  상단 프레임 케이지 (기둥 4 + 상단 레일 4 + 디스플레이 + 버튼) -->
    <!--  단일 fixed 링크로 묶음. 좌표는 base_link 기준.               -->
    <!-- ============================================================= -->
    <link name="frame">
        <!-- 수직 기둥 4개 -->
        <visual>
            <origin xyz="${post_x} ${post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
            <material name="silver"/>
        </visual>
        <visual>
            <origin xyz="${post_x} ${-post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
            <material name="silver"/>
        </visual>
        <visual>
            <origin xyz="${-post_x} ${post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
            <material name="silver"/>
        </visual>
        <visual>
            <origin xyz="${-post_x} ${-post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
            <material name="silver"/>
        </visual>

        <!-- 상단 레일 X 방향 2개 -->
        <visual>
            <origin xyz="0 ${post_y} ${top_z}"/>
            <geometry><box size="${2*post_x + post_t} ${post_t} ${post_t}"/></geometry>
            <material name="silver"/>
        </visual>
        <visual>
            <origin xyz="0 ${-post_y} ${top_z}"/>
            <geometry><box size="${2*post_x + post_t} ${post_t} ${post_t}"/></geometry>
            <material name="silver"/>
        </visual>
        <!-- 상단 레일 Y 방향 2개 -->
        <visual>
            <origin xyz="${post_x} 0 ${top_z}"/>
            <geometry><box size="${post_t} ${2*post_y} ${post_t}"/></geometry>
            <material name="silver"/>
        </visual>
        <visual>
            <origin xyz="${-post_x} 0 ${top_z}"/>
            <geometry><box size="${post_t} ${2*post_y} ${post_t}"/></geometry>
            <material name="silver"/>
        </visual>

        <!-- 선반 플레이트 (프레임 기둥에 끼워진 중상단 선반. 지붕 아님) -->
        <visual>
            <origin xyz="0 0 ${deck_z + 0.28}"/>
            <geometry><box size="${2*post_x + post_t} ${2*post_y + post_t} 0.02"/></geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${deck_z + 0.28}"/>
            <geometry><box size="${2*post_x + post_t} ${2*post_y + post_t} 0.02"/></geometry>
        </collision>

        <!-- 전면 가로 프로파일 2개 (LCD/카메라 장착용) -->
        <visual>
            <origin xyz="${post_x} 0 ${deck_z + 0.18}"/>
            <geometry><box size="${post_t} ${2*post_y} ${post_t}"/></geometry>
            <material name="silver"/>
        </visual>
        <visual>
            <origin xyz="${post_x} 0 ${deck_z + 0.32}"/>
            <geometry><box size="${post_t} ${2*post_y} ${post_t}"/></geometry>
            <material name="silver"/>
        </visual>

        <!-- 디스플레이 (전면 가로바에 부착) -->
        <visual>
            <origin xyz="${post_x + 0.012} 0 ${deck_z + 0.18}"/>
            <geometry><box size="0.02 0.24 0.14"/></geometry>
            <material name="cyan"/>
        </visual>

        <!-- 전원 버튼 (녹색, 가로바에 부착) -->
        <visual>
            <origin xyz="${post_x + 0.012} 0.14 ${deck_z + 0.32}"/>
            <geometry><box size="0.03 0.03 0.03"/></geometry>
            <material name="green"/>
        </visual>

        <!-- 충돌은 기둥만 (프레임 물리 외곽) -->
        <collision>
            <origin xyz="${post_x} ${post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
        </collision>
        <collision>
            <origin xyz="${post_x} ${-post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
        </collision>
        <collision>
            <origin xyz="${-post_x} ${post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
        </collision>
        <collision>
            <origin xyz="${-post_x} ${-post_y} ${deck_z + frame_h/2}"/>
            <geometry><box size="${post_t} ${post_t} ${frame_h}"/></geometry>
        </collision>

        <!-- 프레임 전체 질량 근사 (기둥 + 레일 + 2층 판) -->
        <xacro:inertial_box mass="1.2" x="${2*post_x}" y="${2*post_y}" z="${frame_h}">
            <origin xyz="0 0 ${deck_z + frame_h/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="frame_joint" type="fixed">
        <parent link="chassis"/>
        <child  link="frame"/>
        <origin xyz="0 0 0"/>
    </joint>

    <!-- ============================================================= -->
    <!--  라이다 (하단 상판 전방 중앙)                                  -->
    <!-- ============================================================= -->
    <link name="lidar_mount">
        <visual>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <geometry><cylinder radius="0.025" length="0.02"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <geometry><cylinder radius="0.025" length="0.02"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.01" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="3.0e-05" ixy="0" ixz="0" iyy="3.0e-05" iyz="0" izz="3.0e-05"/>
        </inertial>
    </link>

    <joint name="lidar_mount_fixed_joint" type="fixed">
        <parent link="chassis"/>
        <child link="lidar_mount"/>
        <!-- 하단 베이스 상판 전방 중앙 -->
        <origin xyz="${lidar_x} 0.0 ${deck_z}" rpy="0 0 0"/>
    </joint>

    <!-- 레이저 링크 (라이다 본체). yaw=π 는 실로봇 거꾸로 마운트 보정값 -->
    <!-- ⚠ 새 마운트 방향은 실로봇에서 재검증 필요 -->
    <link name="laser_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.03" length="0.06"/></geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><cylinder radius="0.03" length="0.06"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.2"/>
            <inertia ixx="1.2e-04" ixy="0" ixz="0" iyy="1.2e-04" iyz="0" izz="1.6e-04"/>
        </inertial>
    </link>

    <joint name="laser_link_fixed_joint" type="fixed">
        <parent link="lidar_mount"/>
        <child link="laser_link"/>
        <origin xyz="0.0 0.0 0.05" rpy="0 0 ${pi}"/>
    </joint>

    <!-- ============================================================= -->
    <!--  Depth 카메라 (상단 프레임 전면, 전방 주시)                    -->
    <!-- ============================================================= -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.025 0.09 0.025"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><box size="0.025 0.09 0.025"/></geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="1.0e-05" ixy="0" ixz="0" iyy="1.0e-05" iyz="0" izz="1.0e-05"/>
        </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="frame"/>
        <child link="camera_link"/>
        <!-- 상단 전면 가로 프로파일(z=deck_z+0.32)에 부착. 전방(+X) 주시 -->
        <origin xyz="${post_x + 0.02} 0 ${deck_z + 0.32}" rpy="0 0 0"/>
    </joint>

    <!-- 광학 프레임 (ROS optical 규약 - z 전방, x 우측, y 하방) -->
    <link name="camera_link_optical"/>
    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

</robot>
