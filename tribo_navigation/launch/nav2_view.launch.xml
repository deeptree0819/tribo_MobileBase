<?xml version="1.0"?>
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz_config" default="$(find-pkg-share tribo_navigation)/rviz/navigation.rviz"/>

  <node pkg="rviz2" exec="rviz2" name="nav2_view" output="screen"
        args="-d $(var rviz_config)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
