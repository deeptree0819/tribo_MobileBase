# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ROS 2 colcon workspace artifacts
build/
install/
log/

# Editor / OS
*.swp
.DS_Store
.claude/

# Per-robot auto-generated motor gain calibration (see motor_calib.py). Each
# robot's 4-motor deviation differs, so this is a machine-local override file.
tribo_bringup/config/motor_calib.yaml

# Ad-hoc map captures pulled off a specific robot (binary pgm; not referenced
# by any launch/param file). Keep maps out of the repo.
maps_from_*/

# Per-robot geometry override (wheel_radius / odom effective track).
# Each unit measures differently; see config/unit_geom.yaml.example.
tribo_bringup/config/unit_geom.yaml
